# VideoContextEngine - Environment Configuration Template
# Copy this file to .env and adjust settings as needed. No absolute paths or secrets.

# Storage & Database Locations
VRS_DATA_DIR=data
VRS_APP_DB_PATH=data/app.db
VRS_PLAYBACK_DIR=data/playback

# Video Upload Constraints
VRS_MAX_UPLOAD_MB=2048

# Model & Ingestion Engine
VRS_WHISPER_MODEL=tiny

# Authentication & Session Security (Argon2id + SHA-256 tokens)
VRS_SESSION_TTL_MINUTES=720
VRS_LOCKOUT_ATTEMPTS=5
VRS_LOCKOUT_DURATION_MINUTES=5
VRS_ENABLE_GOOGLE=false

# Server Authentication Secret (required >=32 chars for HMAC-SHA256 verification code hashing)
VRS_AUTH_SECRET=generate_at_least_32_random_characters_secret_here

# Email Verification Policies
VRS_REQUIRE_EMAIL_VERIFICATION=true
VRS_VERIFICATION_CODE_LENGTH=6
VRS_VERIFICATION_TTL_MINUTES=10
VRS_VERIFICATION_MAX_ATTEMPTS=5
VRS_RESEND_COOLDOWN_SECONDS=60
VRS_RESEND_MAX_PER_HOUR=5
VRS_EMAIL_MAX_PER_HOUR=50

# SMTP Mailer Settings (e.g., dedicated Gmail account with Google App Password)
VRS_SMTP_HOST=smtp.gmail.com
VRS_SMTP_PORT=587
VRS_SMTP_SECURITY=starttls
VRS_SMTP_USERNAME=your-dedicated-sender@gmail.com
VRS_SMTP_PASSWORD=your_16_char_google_app_password
VRS_EMAIL_FROM=your-dedicated-sender@gmail.com
VRS_EMAIL_FROM_NAME=VideoContextEngine

# Search Engine & Query Normalization
VRS_QUERY_REWRITE=light
VRS_DEFAULT_TOP_K=5
VRS_MAX_TOP_K=10
VRS_MIN_TOP_K=3
