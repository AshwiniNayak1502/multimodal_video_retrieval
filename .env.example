# VideoContextEngine - Environment Configuration Template
# Copy this file to .env and adjust settings as needed. No absolute paths or secrets.

# Storage & Database Locations
VRS_DATA_DIR=data
VRS_APP_DB_PATH=data/app.db
VRS_PLAYBACK_DIR=data/playback

# Video Upload Constraints
VRS_MAX_UPLOAD_MB=2048

# Model & Ingestion Engine
VRS_WHISPER_MODEL=tiny

# Authentication & Session Security (Argon2id + SHA-256 tokens)
VRS_SESSION_TTL_MINUTES=720
VRS_LOCKOUT_ATTEMPTS=5
VRS_LOCKOUT_DURATION_MINUTES=5
VRS_ENABLE_GOOGLE=false

# Search Engine & Query Normalization
VRS_QUERY_REWRITE=light
VRS_DEFAULT_TOP_K=5
VRS_MAX_TOP_K=10
VRS_MIN_TOP_K=3
