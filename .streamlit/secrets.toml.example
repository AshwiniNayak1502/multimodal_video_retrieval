# .streamlit/secrets.toml.example
# Copy this file to .streamlit/secrets.toml and configure your Google Cloud OAuth credentials.
# Never commit real secrets to version control.

[auth]
redirect_uri = "http://localhost:8502/oauth2callback"
cookie_secret = "CHANGE_ME_GENERATE_A_RANDOM_SECRET_KEY_HERE_MIN_32_CHARS"
client_id = "YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
client_secret = "YOUR_GOOGLE_CLIENT_SECRET"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
expose_tokens = "id"
